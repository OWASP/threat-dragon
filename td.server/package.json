{
  "name": "threat-dragon-server",
  "version": "2.6.2",
  "private": true,
  "scripts": {
    "audit": "npm audit",
    "build": "npm-run-all clean:dist transpile",
    "make-sbom": "npm-run-all -lp --aggregate-output make-sbom:\\*",
    "make-sbom:xml": " cyclonedx-npm --omit=dev --ignore-npm-errors --spec-version=1.5 --output-format=XML  --output-file=sbom.xml",
    "make-sbom:json": "cyclonedx-npm --omit=dev --ignore-npm-errors --spec-version=1.5 --output-format=JSON --output-file=sbom.json",
    "clean": "rimraf --glob *.log .nyc_output/ coverage/ dist/ node_modules/",
    "clean:dist": "rimraf dist",
    "dev": "nodemon dev.js --exec babel-node",
    "lint": "eslint src --fix",
    "pretest": "npm run lint",
    "start": "npm run dev",
    "start:server": "pm2 --name td.server start 'nodemon dev.js --exec babel-node'",
    "stop:server": "pm2 delete td.server",
    "transpile": "babel ./src --out-dir dist",
    "test": "cross-env NODE_OPTIONS=--no-experimental-detect-module NODE_ENV=test nyc mocha --require @babel/register --all true --timeout=900 test/*.spec.js test/**/*.spec.js",
    "test:unit": "cross-env NODE_OPTIONS=--no-experimental-detect-module NODE_ENV=test nyc --reporter=lcov --reporter=text-summary mocha --require @babel/register --all true --timeout=900 test/*.spec.js test/**/*.spec.js"
  },
  "description": "OWASP Threat Dragon - a free, open source threat modeling tool",
  "author": {
    "name": "OWASP Threat Dragon",
    "email": "threat-dragon-project@owasp.org",
    "url": "https://owasp.org/projects/threat-dragon"
  },
  "license": "Apache-2.0",
  "engines": {
    "npm": ">=11.10.0"
  },
  "homepage": "https://owasp.org/projects/threat-dragon",
  "repository": {
    "type": "git",
    "url": "git://github.com/OWASP/threat-dragon.git"
  },
  "bugs": {
    "email": "threat-dragon-project@owasp.org",
    "url": "https://github.com/OWASP/threat-dragon/issues"
  },
  "resolutions": {},
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@gitbeaker/rest": "^43.8.0",
    "@googleapis/drive": "^20.2.0",
    "axios": "^1.21.1",
    "bitbucket": "^2.12.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "octonode": "^0.10.2",
    "serve-favicon": "^2.5.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/node": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.14",
    "@babel/register": "^7.29.13",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.46.0",
    "mocha": "11.8.0",
    "nodemon": "^3.1.14",
    "npm-force-resolutions": "^0.0.10",
    "npm-run-all2": "^8.0.4",
    "nyc": "^18.0.0",
    "passport-local": "1.0.0",
    "pm2": "^7.1.2",
    "rimraf": "^6.1.4",
    "sinon": "^10.0.1",
    "sinon-chai": "^3.7.0",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "request": "npm:@cypress/request@4.0.1",
    "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "qs": "6.16.0",
    "serialize-javascript": "^7.0.5",
    "diff": ">=7.0.0",
    "ip-address": ">=10.7.2",
    "@babel/generator": ">=7.29.14",
    "@babel/helper-compilation-targets": ">=7.29.13",
    "@babel/helper-create-class-features-plugin": ">=7.29.13",
    "@babel/helper-module-transforms": ">=7.29.14",
    "@babel/helper-skip-transparent-expression-wrappers": ">=7.29.13",
    "@babel/helper-string-parser": ">=7.29.14",
    "@babel/helpers": ">=7.29.14",
    "@babel/parser": ">=7.29.14",
    "@babel/plugin-bugfix-safari-rest-destructuring-rhs-array": ">=7.29.13",
    "@babel/plugin-transform-block-scoping": ">=7.29.13",
    "@babel/plugin-transform-class-static-block": ">=7.29.14",
    "@babel/plugin-transform-classes": ">=7.29.11",
    "@babel/plugin-transform-destructuring": ">=7.29.13",
    "@babel/plugin-transform-for-of": ">=7.29.13",
    "@babel/plugin-transform-modules-amd": ">=7.29.14",
    "@babel/plugin-transform-modules-commonjs": ">=7.29.14",
    "@babel/plugin-transform-modules-umd": ">=7.29.14",
    "@babel/plugin-transform-spread": ">=7.29.11",
    "@babel/traverse": ">=7.29.14",
    "@babel/types": ">=7.29.14",
    "@isaacs/nonrecursive-glob-match": ">=1.1.0",
    "content-disposition": ">=2.0.1",
    "glob": ">=14.0.6",
    "lru-cache": ">=11.5.3",
    "minimatch": ">=11.0.8",
    "path-scurry": ">=3.0.0",
    "superagent": ">=10.4.2"
  }
}
